# Copy this file to clone-database.env. Do not commit the copied file.
# All URLs use PostgreSQL tooling syntax (not SQLAlchemy's +psycopg variant).

SOURCE_DATABASE_URL=postgresql://SOURCE_USER:SOURCE_PASSWORD@SOURCE_HOST:SOURCE_PORT/SOURCE_DATABASE
TARGET_ADMIN_DATABASE_URL=postgresql://ADMIN_USER:ADMIN_PASSWORD@TARGET_HOST:TARGET_PORT/postgres
TARGET_DATABASE_NAME=findog_test_db
TARGET_DATABASE_OWNER=findog_test
