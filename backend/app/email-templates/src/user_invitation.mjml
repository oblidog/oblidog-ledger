<mjml>
  <mj-body background-color="#fafbfc">
    <mj-section background-color="#fff" padding="40px 20px">
      <mj-column vertical-align="middle" width="100%">
        <mj-text align="center" padding="35px" font-size="20px" font-family="Arial, Helvetica, sans-serif" color="#333">{{ tr('invitation_title', project_name=project_name) }}</mj-text>
        <mj-text align="center" font-size="16px" font-family="Arial, Helvetica, sans-serif" color="#555">{{ tr('invitation_intro', email=email) }}</mj-text>
        <mj-button align="center" font-size="18px" background-color="#009688" border-radius="8px" color="#fff" href="{{ link }}" padding="15px 30px">{{ tr('invitation_action') }}</mj-button>
        <mj-text align="center" font-size="16px" font-family="Arial, Helvetica, sans-serif" color="#555">{{ tr('invitation_copy') }} <a href="{{ link }}">{{ link }}</a></mj-text>
        <mj-text align="center" font-size="14px" font-family="Arial, Helvetica, sans-serif" color="#555">{{ tr('invitation_expiry', count=valid_hours) }} {{ tr('invitation_ignore') }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
