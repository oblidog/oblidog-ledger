{
  "name": "frontend",
  "private": true,
  "version": "0.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run typecheck",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "preview": "vite preview",
    "generate-client": "openapi-ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "bun test src build",
    "test:e2e": "playwright test",
    "test:i18n": "playwright test --config playwright.i18n.config.ts",
    "typecheck": "bun ./node_modules/@typescript/native/bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-avatar": "^1.3.1",
