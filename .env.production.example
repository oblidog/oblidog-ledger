# Immutable GHCR tag to deploy. Copy this file to .env on the VPS.
TAG=v0.0.1a0

# Application and public URLs
PROJECT_NAME=Oblidog
DOMAIN=ledger.example.com
FRONTEND_HOST=https://ledger.example.com
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=https://ledger.example.com
VITE_API_URL=https://api.ledger.example.com

# Browser sessions use host-only HttpOnly cookies. Secure defaults to true in
# production. Keep SameSite=lax when frontend and API share the same site.
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=true

# Generate a unique value, for example: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Externally managed PostgreSQL database
POSTGRES_SERVER=postgres.example.com
POSTGRES_PORT=5432
# Legacy database identifiers retained to avoid requiring a data migration.
POSTGRES_DB=findog_ledger
POSTGRES_USER=findog_ledger
POSTGRES_PASSWORD=replace-with-the-database-password

# SMTP is optional. Leave the values empty to disable outgoing email.
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Oblidog
# One-time user invitation lifetime.
USER_INVITATION_EXPIRE_HOURS=48

# Optional legacy import configuration. It is disabled by default.
# To enable it, set LEGACY_IMPORT_MODE to manual_only or scheduled and provide
# all of: LEGACY_IMPORT_LEDGER_ID, DROPBOX_API_KEY, and a protected YAML file
# mounted read-only at LEGACY_IMPORT_CONFIG_PATH in backend and scheduler.
# LEGACY_IMPORT_CONFIG_PATH=config/legacy-import.yaml
# LEGACY_IMPORT_MODE=disabled
# LEGACY_IMPORT_LEDGER_ID=
# DROPBOX_API_KEY=

# System Run scheduler (daily at 00:05 in the configured timezone)
SYSTEM_RUN_SCHEDULE=5 0 * * *
SYSTEM_RUN_TIMEZONE=Europe/Warsaw
BUSINESS_CALENDAR_COUNTRY=PL
SYSTEM_RUN_TIMEOUT_SECONDS=3600
SYSTEM_RUN_STALE_AFTER_MINUTES=120

# Optional error tracking
SENTRY_DSN=
