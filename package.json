{
  "name": "oblidog-ledger",
  "private": true,
  "workspaces": [
    "frontend",
    "emails"
  ],
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "lint": "bun run --filter frontend lint",
    "test": "bun run --filter frontend test",
    "test:ui": "bun run --filter frontend test:ui",
    "email:dev": "bun run --filter @oblidog/emails dev",
    "email:export": "bun run --filter @oblidog/emails export",
    "email:check": "bun run --filter @oblidog/emails check"
  }
}
