<!doctype html>
<html lang="{{ language }}" lang="en">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
  <body style="background:#fafbfc;font-family:Arial,Helvetica,sans-serif;color:#333;margin:0;padding:40px 20px">
    <main style="background:#fff;max-width:560px;margin:0 auto;padding:40px 20px;text-align:center">
      <h1 style="font-size:20px">{{ tr('invitation_title', project_name=project_name) }}</h1>
      <p>{{ tr('invitation_intro', email=email) }}</p>
      <p style="margin:30px"><a href="{{ link }}" style="background:#009688;color:#fff;padding:12px 24px;border-radius:8px;text-decoration:none">{{ tr('invitation_action') }}</a></p>
      <p>{{ tr('invitation_copy') }}<br><a href="{{ link }}">{{ link }}</a></p>
      <p style="font-size:14px;color:#555">{{ tr('invitation_expiry', count=valid_hours) }} {{ tr('invitation_ignore') }}</p>
    </main>
  </body>
</html>
