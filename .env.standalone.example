# Use a published release tag. Do not use latest or a moving branch tag.
TAG=v0.15.0

PROJECT_NAME=Oblidog
DOMAIN=localhost
FRONTEND_HOST=http://localhost:8080
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:8000

# Set the bind addresses to 127.0.0.1 when a host reverse proxy is used.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000

SESSION_COOKIE_SAMESITE=lax
# Set to true only when both public URLs use HTTPS.
SESSION_COOKIE_SECURE=false

# Replace every value below before starting the stack.
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# PostgreSQL stays on the private Compose network. Its data is stored in the
# named postgres-data volume.
POSTGRES_DB=findog_ledger
POSTGRES_USER=findog_ledger
POSTGRES_PASSWORD=replace-with-the-database-password

# SMTP is optional. Leave the values empty to disable outgoing email.
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Oblidog
USER_INVITATION_EXPIRE_HOURS=48

SYSTEM_RUN_SCHEDULE=5 0 * * *
SYSTEM_RUN_TIMEZONE=Europe/Warsaw
BUSINESS_CALENDAR_COUNTRY=PL
SYSTEM_RUN_TIMEOUT_SECONDS=3600
SYSTEM_RUN_STALE_AFTER_MINUTES=120

SENTRY_DSN=
