# Local public-demo harness. Copy to .env.demo before running.

PROJECT_NAME=Oblidog Demo
STACK_NAME=oblidog-demo-local
DOMAIN=localhost.tiangolo.com
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=demo
BACKEND_CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Local-only secrets. Replace these if the environment becomes reachable outside localhost.
SECRET_KEY=demo-local-secret-key-replace-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=demo-local-admin-password
DEMO_USER_PASSWORD=public-demo-password

# Local PostgreSQL used only by the demo harness.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=oblidog_demo
POSTGRES_USER=oblidog_demo
POSTGRES_PASSWORD=demo-local-postgres-password

# Image names are only used as stable local Compose identifiers when building locally.
DOCKER_IMAGE_BACKEND=oblidog-ledger-backend
DOCKER_IMAGE_FRONTEND=oblidog-ledger-frontend
TAG=demo-local

# Demo mode disables outgoing email and legacy integrations server-side.
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Oblidog
DROPBOX_API_KEY=
LEGACY_IMPORT_MODE=disabled
LEGACY_IMPORT_LEDGER_ID=

# The normal system-run scheduler is disabled by compose.demo.yml.
SYSTEM_RUN_TIMEZONE=Europe/Warsaw
BUSINESS_CALENDAR_COUNTRY=PL
SYSTEM_RUN_TIMEOUT_SECONDS=3600
SYSTEM_RUN_STALE_AFTER_MINUTES=120

SENTRY_DSN=
